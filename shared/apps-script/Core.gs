/**
 * PORTFOLIO CORE — shared by every Mini App. Each app = its own Apps Script project with
 * Core.gs (this file, identical everywhere) + the app's own file (sets THIS_APP and its module).
 * To share ONE master ledger across apps, set the same MASTER_SHEET_ID in each project BEFORE install().
 * Shared core: Telegram initData auth, users, usage/free allowance, subscriptions,
 * payments (Stars, USDT TRC20/BEP20, manual mobile money), admin settings, daily expiry.
 *
 * SECRETS live ONLY in Script Properties (Project Settings -> Script properties):
 *   BOT_TOKEN_<app>   e.g. BOT_TOKEN_converter   (required for Telegram auth, Stars, sending files)
 *   ADMIN_IDS         comma-separated Telegram user IDs, e.g. 123456789
 *   SERVER_SECRET     shared with the Netlify webhook function (generated by install())
 *   TRONGRID_KEY      optional, TronGrid API key for TRC20 checks
 *   ETHERSCAN_KEY     Etherscan V2 API key for BEP20 (BSC, chainid 56) checks
 *   MASTER_SHEET_ID   created by install()
 *
 * First run: select install() and press Run. Then Deploy -> New deployment -> Web app
 *   (Execute as: Me, Who has access: Anyone). Put the /exec URL in config.js -> apiUrl.
 */

var SCHEMA = {
  Users:         ['user_id','app','username','first_name','language','region','phone','phone_verified','start_param','edition','created_at','last_seen','referred_by'],
  Usage:         ['user_id','app','free_used','total_used','last_tool','last_used','credits'],
  Subscriptions: ['user_id','app','plan','status','start_date','expiry_date','edition','order_id'],
  Payments:      ['order_id','user_id','app','plan','amount','currency','method','status','tx_ref','created_at','paid_at','expiry_date','edition','note','code','discount'],
  Settings:      ['app','json','updated_at'],
  Log:           ['time','user_id','app','event','detail'],
  Codes:         ['code','app','scope','owner_id','pct','max_uses','used','expires','plans','active','note','created_at'],
  Referrals:     ['referrer_id','referee_id','app','status','created_at','rewarded_at','reward'],
  Outbox:        ['msg_id','app','chat_id','text','markup','status','created_at','sent_at','error']
};
var EXTRA_SCHEMA = EXTRA_SCHEMA || {}; // app modules add sheets here (safe for any file order)
var LOCAL_METHODS = ['evc','zaad','sahal','mpesa'];
var USDT = {
  usdt_trc20: { contract: 'TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t', decimals: 6, network: 'TRC20 (Tron)' },
  usdt_bep20: { contract: '0x55d398326f99059fF775485246999027B3197955', decimals: 18, network: 'BEP20 (BNB Smart Chain)' }
};
var ORDER_TTL_HOURS = 6;

/* App modules register here (see gatekeeper.gs):
   APP_HOOKS[app] = { routes:{action:fn(ctx,req)}, server:{action:fn(req)}, resolvePlan:fn(ctx,planId), planForOrder:fn(order), onPaid:fn(order,plan,exp) } */
var APP_HOOKS = APP_HOOKS || {};
var APP_DEFAULTS = APP_DEFAULTS || {};   // per-app default settings, registered by the app file
var APP_SECRETS = APP_SECRETS || {};     // extra write-only secrets per app, e.g. ['GEMINI_KEY']
var THIS_APP = THIS_APP || { id: 'converter', url: '', button: 'Open' }; // set in the app file

/* ---------- per-app default settings (extend when adding apps) ---------- */
function defaultSettings(app) {
  var base = {
    appName: 'App', testMode: true, freeAllowance: 2, freeMaxMB: 10, paidMaxMB: 100, supportContact: '', localPrefixes: '252',
    plans: [
      { id: 'pro_m', label: 'Pro · 1 month', days: 30, usd: 1, stars: 75, region: 'GLOBAL' },
      { id: 'pro_y', label: 'Pro · 1 year', days: 365, usd: 8, stars: 600, region: 'GLOBAL' },
      { id: 'pro_m_l', label: 'Pro · 1 bil', days: 30, usd: 1, stars: 75, region: 'LOCAL' }
    ],
    methods: { stars: true, usdt_trc20: '', usdt_bep20: '', evc: '', zaad: '', sahal: '', mpesa: '' },
    x_refOn: true, x_refNewPct: 10, x_refDays: 7, x_refCredits: 0
  };
  return Object.assign(base, JSON.parse(JSON.stringify(APP_DEFAULTS[app] || {})));
}

/* ======================= ENTRY ======================= */
function doPost(e) {
  var out;
  try {
    var req = JSON.parse(e.postData.contents);
    out = req.serverSecret ? serverRoute(req) : route(req);
  } catch (err) {
    out = { ok: false, error: String(err && err.message || err) };
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}
function doGet() {
  return ContentService.createTextOutput(JSON.stringify({ ok: true, service: 'up' })).setMimeType(ContentService.MimeType.JSON);
}

function prop(k) { return PropertiesService.getScriptProperties().getProperty(k) || ''; }
function setProp(k, v) { PropertiesService.getScriptProperties().setProperty(k, v); }
function appId(a) { return String(a || THIS_APP.id).replace(/[^a-z0-9_]/gi, '').slice(0, 30); }
function botToken(app) { return prop('BOT_TOKEN_' + app); }
function adminIds() { return prop('ADMIN_IDS').split(',').map(function (s) { return s.trim(); }).filter(String); }

/* ======================= AUTH ======================= */
function verifyInitData(initData, token) {
  if (!initData || !token) return null;
  var pairs = String(initData).split('&'), data = {}, hash = '';
  pairs.forEach(function (p) {
    var i = p.indexOf('='); if (i < 0) return;
    var k = decodeURIComponent(p.slice(0, i)), v = decodeURIComponent(p.slice(i + 1).replace(/\+/g, '%20'));
    if (k === 'hash') hash = v; else data[k] = v;
  });
  if (!hash) return null;
  var dcs = Object.keys(data).sort().map(function (k) { return k + '=' + data[k]; }).join('\n');
  var secret = Utilities.computeHmacSha256Signature(Utilities.newBlob(token).getBytes(), Utilities.newBlob('WebAppData').getBytes());
  var sig = Utilities.computeHmacSha256Signature(Utilities.newBlob(dcs).getBytes(), secret);
  var hex = sig.map(function (b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
  if (hex !== hash) return null;
  if (Date.now() / 1000 - Number(data.auth_date || 0) > 86400) return null; // 24h freshness
  var user = data.user ? JSON.parse(data.user) : null;
  if (!user || !user.id) return null;
  return { user: user, start_param: data.start_param || '' };
}

/* ======================= SHEETS ======================= */
var _ss;
function ss() { if (!_ss) _ss = SpreadsheetApp.openById(prop('MASTER_SHEET_ID')); return _ss; }
function sh(name) { return ss().getSheetByName(name); }
// Each tab is read at most once per request (_rc cache); writes keep the cache in step; a lock clears it.
var _rc = {};
function rows(name) {
  if (_rc[name]) return _rc[name];
  var s = sh(name), v = s.getDataRange().getValues(), h = v.shift();
  return (_rc[name] = v.map(function (r, i) { var o = { _row: i + 2 }; h.forEach(function (k, j) { o[k] = r[j]; }); return o; }));
}
function delRow(name, row) { sh(name).deleteRow(row._row); delete _rc[name]; }
function find(name, fn) { var r = rows(name); for (var i = 0; i < r.length; i++) if (fn(r[i])) return r[i]; return null; }
function schemaOf(name) { return SCHEMA[name] || EXTRA_SCHEMA[name]; }
// Strings that Sheets would coerce (dates, times, +252… phones, leading zeros, formulas) are stored as plain text.
function cell(v) { return typeof v === 'string' && /^[\d+=\-.@]/.test(v) ? "'" + v : v; }
function append(name, obj) { var h = schemaOf(name); sh(name).appendRow(h.map(function (k) { return obj[k] === undefined ? '' : cell(obj[k]); })); delete _rc[name]; }
function update(name, row, obj) {
  var h = schemaOf(name), s = sh(name);
  Object.keys(obj).forEach(function (k) { var c = h.indexOf(k); if (c >= 0) { s.getRange(row._row, c + 1).setValue(cell(obj[k])); row[k] = obj[k]; } });
}
function log(uid, app, ev, detail) { try { append('Log', { time: new Date(), user_id: uid, app: app, event: ev, detail: String(detail || '').slice(0, 500) }); } catch (e) {} }
function iso(d) { return d ? new Date(d).toISOString() : ''; }

/* ======================= SETTINGS ======================= */
function getSettings(app) {
  var c = CacheService.getScriptCache(), k = 'set_' + app, hit = c.get(k);
  if (hit) return JSON.parse(hit);
  var r = find('Settings', function (x) { return x.app === app; }), d = defaultSettings(app), st = d;
  if (r && r.json) { st = Object.assign(d, JSON.parse(r.json)); st.methods = Object.assign(defaultSettings(app).methods, st.methods || {}); }
  c.put(k, JSON.stringify(st), 300);
  return st;
}
function saveSettings(app, st) {
  var clean = sanitizeSettings(app, st), r = find('Settings', function (x) { return x.app === app; });
  if (r) update('Settings', r, { json: JSON.stringify(clean), updated_at: new Date() });
  else append('Settings', { app: app, json: JSON.stringify(clean), updated_at: new Date() });
  CacheService.getScriptCache().remove('set_' + app);
  return clean;
}
function sanitizeSettings(app, st) {
  var d = defaultSettings(app), o = {};
  o.appName = String(st.appName || d.appName).slice(0, 60);
  o.testMode = !!st.testMode;
  ['freeAllowance', 'freeMaxMB', 'paidMaxMB'].forEach(function (k) { var n = Number(st[k]); o[k] = isFinite(n) && n >= 0 ? n : d[k]; });
  o.supportContact = String(st.supportContact || '').slice(0, 80);
  o.localPrefixes = String(st.localPrefixes || '252').replace(/[^0-9,]/g, '');
  o.plans = (st.plans || []).slice(0, 12).map(function (p) {
    return { id: String(p.id || '').replace(/[^\w-]/g, '').slice(0, 30), label: String(p.label || '').slice(0, 60),
      days: Math.max(0, Number(p.days) || 0), credits: Math.max(0, Math.round(Number(p.credits) || 0)), usd: Math.max(0, Number(p.usd) || 0), stars: Math.max(0, Math.round(Number(p.stars) || 0)),
      region: ['GLOBAL', 'LOCAL', 'ALL'].indexOf(p.region) >= 0 ? p.region : 'GLOBAL' };
  }).filter(function (p) { return p.id; });
  var m = st.methods || {};
  o.methods = { stars: !!m.stars };
  ['usdt_trc20', 'usdt_bep20', 'evc', 'zaad', 'sahal', 'mpesa'].forEach(function (k) { o.methods[k] = String(m[k] || '').trim().slice(0, 80); });
  Object.keys(st).forEach(function (k) { if (!(k in o) && /^x_/.test(k)) o[k] = st[k]; }); // app-specific extras (prefix x_)
  return o;
}

/* ======================= USERS / ACCESS ======================= */
function upsertUser(u, app, edition, startParam) {
  var r = find('Users', function (x) { return String(x.user_id) === String(u.id) && x.app === app; });
  var now = new Date();
  if (r) { update('Users', r, { last_seen: now, username: u.username || '', first_name: u.first_name || '' }); return r; }
  var o = { user_id: String(u.id), app: app, username: u.username || '', first_name: u.first_name || '', language: u.language_code || '',
    region: /^local/i.test(startParam || '') ? 'LOCAL' : 'GLOBAL', phone: '', phone_verified: false, start_param: startParam || '',
    edition: edition || 'global', created_at: now, last_seen: now, referred_by: '' };
  var ref = /(?:^|_)r(\d{3,15})(?:_|$)/.exec(startParam || '');   // referral link: ?startapp=r<inviter id>
  if (ref && ref[1] !== String(u.id) && find('Users', function (x) { return String(x.user_id) === ref[1] && x.app === app; })) {
    o.referred_by = ref[1];
    append('Referrals', { referrer_id: ref[1], referee_id: String(u.id), app: app, status: 'joined', created_at: now });
  }
  append('Users', o);
  return find('Users', function (x) { return String(x.user_id) === String(u.id) && x.app === app; });
}
function activeSub(uid, app) {
  var now = new Date(), best = null;
  rows('Subscriptions').forEach(function (s) {
    if (String(s.user_id) === String(uid) && s.app === app && s.status === 'active' && new Date(s.expiry_date) > now)
      if (!best || new Date(s.expiry_date) > new Date(best.expiry_date)) best = s;
  });
  return best;
}
function usageRow(uid, app) {
  var r = find('Usage', function (x) { return String(x.user_id) === String(uid) && x.app === app; });
  if (!r) { append('Usage', { user_id: String(uid), app: app, free_used: 0, total_used: 0 }); r = find('Usage', function (x) { return String(x.user_id) === String(uid) && x.app === app; }); }
  return r;
}
function computeAccess(st, sub, freeUsed, simFree, credits) {
  var test = st.testMode && !simFree, allow = Number(st.freeAllowance) || 0, left = Math.max(0, allow - freeUsed), cr = Number(credits) || 0;
  return { entitled: !!(test || sub || left > 0 || cr > 0), reason: test ? 'test' : sub ? 'sub' : left > 0 ? 'free' : cr > 0 ? 'credits' : 'blocked',
    plan: sub ? sub.plan : null, expiry: sub ? iso(sub.expiry_date) : null, freeUsed: freeUsed, freeAllowance: allow, freeLeft: left, credits: cr,
    maxMB: (test || sub) ? Number(st.paidMaxMB) : Number(st.freeMaxMB), paidMaxMB: Number(st.paidMaxMB) };
}
function regionOf(u) { return u.region === 'LOCAL' || u.phone_verified === true || u.phone_verified === 'TRUE' ? 'LOCAL' : 'GLOBAL'; }
function availMethods(st, region, starsReady) {
  var m = st.methods || {}, o = [];
  if (m.stars && starsReady) o.push({ id: 'stars' });
  if (m.usdt_trc20) o.push({ id: 'usdt_trc20' });
  if (m.usdt_bep20) o.push({ id: 'usdt_bep20' });
  if (region === 'LOCAL') LOCAL_METHODS.forEach(function (k) { if (m[k]) o.push({ id: k, local: true }); });
  return o;
}
function plansFor(st, region) { return (st.plans || []).filter(function (p) { return p.region === 'ALL' || p.region === region; }); }

/* ======================= CLIENT ROUTER ======================= */
function route(req) {
  var app = appId(req.app), token = botToken(app), st = getSettings(app);
  var auth = verifyInitData(req.initData, token), verified = !!auth;
  if (!auth) {
    // Without a valid Telegram signature we only allow a read-only preview while TEST MODE is on.
    if (!(st.testMode && !token)) return { ok: false, error: 'unauthorized' };
    auth = { user: { id: 'preview', first_name: 'Preview' }, start_param: req.start || '' };
  }
  var u = auth.user, uid = String(u.id), isAdmin = verified && adminIds().indexOf(uid) >= 0, simFree = !!req.simulateFree && st.testMode;
  var urow = verified ? upsertUser(u, app, req.edition, auth.start_param || String(req.start || '').slice(0, 64)) : { region: /^local/i.test(auth.start_param) ? 'LOCAL' : 'GLOBAL' };
  var region = regionOf(urow);
  var ctx = { app: app, st: st, u: u, uid: uid, urow: urow, region: region, isAdmin: isAdmin, verified: verified, simFree: simFree, token: token };
  var a = String(req.action || '');
  if (/^admin/.test(a) && !isAdmin) return { ok: false, error: 'forbidden' };
  if (!verified && a !== 'init') return { ok: false, error: 'unauthorized' };
  switch (a) {
    case 'init': return initPayload(ctx);
    case 'consume': return consume(ctx, req);
    case 'sendFile': return sendFile(ctx, req);
    case 'sendReport': return sendReport(ctx, req);
    case 'createOrder': return createOrder(ctx, req);
    case 'checkOrder': return checkOrder(ctx, req);
    case 'submitManual': return submitManual(ctx, req);
    case 'adminGet':
      var sec = { BOT_TOKEN: !!token, TRONGRID_KEY: !!prop('TRONGRID_KEY'), ETHERSCAN_KEY: !!prop('ETHERSCAN_KEY') };
      (APP_SECRETS[app] || []).forEach(function (k) { sec[k] = !!prop(k); });
      return { ok: true, settings: st, secrets: sec };
    case 'adminSave': saveSettings(app, req.settings || {}); log(uid, app, 'settings_saved', ''); return { ok: true };
    case 'adminSetSecret': return adminSetSecret(ctx, req);
    case 'adminPending': return { ok: true, items: rows('Payments').filter(function (p) { return p.app === app && p.status === 'review'; }).map(cleanRow) };
    case 'adminDecide': return adminDecide(ctx, req);
    case 'adminStats': return adminStats(ctx);
    case 'adminResetMe': return adminResetMe(ctx);
    case 'adminRevenue': return adminRevenue(ctx, req);
    case 'checkCode': return checkCode(ctx, req);
    case 'refStats': return refStats(ctx);
    case 'adminCodes': return { ok: true, codes: rows('Codes').filter(function (c) { return c.app === app && c.scope === 'all'; }).map(codeOut) };
    case 'adminCodeSave': return codeSave(ctx, req, 'all');
    case 'adminCodeToggle': return codeToggle(ctx, req, 'all');
  }
  var H = APP_HOOKS[app];
  if (H && H.routes && H.routes[a]) return H.routes[a](ctx, req);
  return { ok: false, error: 'unknown_action' };
}
function cleanRow(r) { var o = {}; Object.keys(r).forEach(function (k) { if (k !== '_row') o[k] = r[k] instanceof Date ? r[k].toISOString() : r[k]; }); return o; }

function accessFor(ctx) {
  if (!ctx.verified) return computeAccess(ctx.st, null, 0, ctx.simFree);
  var us = usageRow(ctx.uid, ctx.app);
  return computeAccess(ctx.st, activeSub(ctx.uid, ctx.app), Number(us.free_used) || 0, ctx.simFree, us.credits);
}
function initPayload(ctx) {
  return { ok: true, verified: ctx.verified, isAdmin: ctx.isAdmin, user: { id: ctx.u.id, name: ctx.u.first_name || '' },
    region: ctx.region, phoneVerified: ctx.urow.phone_verified === true || ctx.urow.phone_verified === 'TRUE',
    access: accessFor(ctx), plans: plansFor(ctx.st, ctx.region), methods: availMethods(ctx.st, ctx.region, !!ctx.token),
    appName: ctx.st.appName, support: ctx.st.supportContact,
    ref: refOn(ctx.st) ? { on: true, arg: 'r' + ctx.uid, newPct: Number(ctx.st.x_refNewPct) || 0, days: Number(ctx.st.x_refDays) || 0, credits: Number(ctx.st.x_refCredits) || 0 } : { on: false },
    firstPct: ctx.verified ? refFirstPct(ctx) : 0 };
}
function consume(ctx, req) {
  var lock = LockService.getScriptLock(); lock.waitLock(10000); _rc = {};
  try {
    var sub = activeSub(ctx.uid, ctx.app), us = usageRow(ctx.uid, ctx.app), fu = Number(us.free_used) || 0, cr = Number(us.credits) || 0;
    var ac = computeAccess(ctx.st, sub, fu, ctx.simFree, cr);
    if (!ac.entitled) return { ok: true, allowed: false, access: ac };
    if (ac.reason === 'free') fu++; else if (ac.reason === 'credits') cr--;
    update('Usage', us, { free_used: fu, credits: cr, total_used: (Number(us.total_used) || 0) + 1, last_tool: String(req.tool || '').slice(0, 30), last_used: new Date() });
    var tok = Utilities.getUuid();
    CacheService.getScriptCache().put('dl_' + tok, ctx.uid + '|' + ctx.app, 1800); // 30 min delivery window
    return { ok: true, allowed: true, token: tok, access: computeAccess(ctx.st, sub, fu, ctx.simFree, cr) };
  } finally { lock.releaseLock(); }
}

/* ======================= TELEGRAM ======================= */
function tgCall(token, method, payload) {
  var opts = { method: 'post', muteHttpExceptions: true };
  var hasBlob = payload && Object.keys(payload).some(function (k) { return payload[k] && payload[k].getBytes; });
  if (hasBlob) opts.payload = payload; else { opts.contentType = 'application/json'; opts.payload = JSON.stringify(payload || {}); }
  var r = UrlFetchApp.fetch('https://api.telegram.org/bot' + token + '/' + method, opts);
  return JSON.parse(r.getContentText());
}
/* Message queue: bulk messages (broadcasts, reminders) are sent in batches by cronUsdt() every 5 minutes,
   so big channels never hit the 6-minute run limit or Telegram's ~30 messages/second limit. */
function queueMsg(app, chatId, text, markup) { append('Outbox', { msg_id: Utilities.getUuid().slice(0, 12), app: app, chat_id: String(chatId), text: String(text).slice(0, 4000), markup: markup ? JSON.stringify(markup) : '', status: 'queued', created_at: new Date() }); }
function processOutbox(max) {
  var sent = 0, t0 = Date.now(), tokens = {};
  rows('Outbox').some(function (m) {
    if (m.status !== 'queued') return false;
    if (sent >= (max || 400) || Date.now() - t0 > 240000) return true;
    var tok = tokens[m.app] || (tokens[m.app] = botToken(m.app)); if (!tok) return false;
    var r; try { r = tgCall(tok, 'sendMessage', { chat_id: m.chat_id, text: m.text, reply_markup: m.markup ? JSON.parse(m.markup) : undefined }); } catch (e) { r = { ok: false, description: String(e) }; }
    update('Outbox', m, { status: r.ok ? 'sent' : 'failed', sent_at: new Date(), error: r.ok ? '' : String(r.description || r.error_code || '').slice(0, 120) });
    sent++; Utilities.sleep(40);
    return false;
  });
  return sent;
}
function notify(app, chatId, text) { var t = botToken(app); if (t && chatId) try { tgCall(t, 'sendMessage', { chat_id: chatId, text: text }); } catch (e) {} }
function notifyAdmins(app, text) { adminIds().forEach(function (id) { notify(app, id, text); }); }

function sendFile(ctx, req) {
  var key = 'dl_' + String(req.token || ''), v = CacheService.getScriptCache().get(key);
  if (!v || v !== ctx.uid + '|' + ctx.app) return { ok: false, error: 'expired' };
  if (!ctx.token) return { ok: false, error: 'bot_not_configured' };
  var bytes = Utilities.base64Decode(String(req.data || ''));
  if (bytes.length > 45 * 1024 * 1024) return { ok: false, error: 'too_large' };
  var name = String(req.name || 'file').replace(/[^\w\-. ]+/g, '_').slice(0, 80);
  var blob = Utilities.newBlob(bytes, String(req.mime || 'application/octet-stream'), name);
  var r = tgCall(ctx.token, 'sendDocument', { chat_id: ctx.uid, document: blob });
  if (!r.ok) return { ok: false, error: r.error_code === 403 ? 'write_access' : 'telegram_' + r.error_code };
  return { ok: true };
}

// PDF reports made in the app: PDF only, max 8 MB, max 30 per user per day (stops the bot being used as free file hosting).
function sendReport(ctx, req) {
  if (!ctx.token) return { ok: false, error: 'bot_not_configured' };
  var c = CacheService.getScriptCache(), k = 'rep_' + ctx.app + '_' + ctx.uid + '_' + new Date().toISOString().slice(0, 10), n = Number(c.get(k) || 0);
  if (n >= 30) return { ok: false, error: 'limit' };
  var bytes = Utilities.base64Decode(String(req.data || ''));
  if (bytes.length > 8 * 1024 * 1024) return { ok: false, error: 'too_large' };
  if (bytes.length < 5 || String.fromCharCode(bytes[0], bytes[1], bytes[2], bytes[3]) !== '%PDF') return { ok: false, error: 'not_pdf' };
  var name = String(req.name || 'report.pdf').replace(/[^\w\-. ]+/g, '_').slice(0, 80); if (!/\.pdf$/i.test(name)) name += '.pdf';
  var r = tgCall(ctx.token, 'sendDocument', { chat_id: ctx.uid, document: Utilities.newBlob(bytes, 'application/pdf', name) });
  if (!r.ok) return { ok: false, error: r.error_code === 403 ? 'write_access' : 'telegram_' + r.error_code };
  c.put(k, String(n + 1), 86400);
  return { ok: true };
}
function isPro(ctx) { var a = accessFor(ctx); return a.reason === 'sub' || a.reason === 'test'; }

/* ======================= PAYMENTS ======================= */
function newOrderId() { return 'O' + Date.now().toString(36).toUpperCase() + Math.floor(Math.random() * 1e4).toString(36).toUpperCase(); }
function createOrder(ctx, req) {
  var H = APP_HOOKS[ctx.app];
  var plan = H && H.resolvePlan ? H.resolvePlan(ctx, req.plan) : plansFor(ctx.st, ctx.region).filter(function (p) { return p.id === req.plan; })[0];
  if (!plan) return { ok: false, error: 'plan' };
  if (plan.free) return { ok: false, error: 'plan' };
  var pr = priceFor(ctx, plan, req.code); if (pr.error) return { ok: false, error: pr.error };
  plan = Object.assign({}, plan, { usd: pr.usd, stars: pr.stars });
  if (pr.free) {   // 100% code: no payment needed
    var fo = { order_id: newOrderId(), user_id: ctx.uid, app: ctx.app, plan: plan.id, method: 'code', status: 'pending', created_at: new Date(), edition: ctx.urow.edition || '', amount: '$0.00', currency: 'USD', code: pr.code, discount: pr.pct };
    append('Payments', fo); markPaid(fo, 'CODE-' + pr.code);
    return { ok: true, free: true, order_id: fo.order_id, method: 'code', status: 'paid', access: accessFor(ctx) };
  }
  var method = String(req.method || ''), methods = availMethods(ctx.st, ctx.region, !!ctx.token).map(function (m) { return m.id; });
  if (methods.indexOf(method) < 0) return { ok: false, error: 'method' };
  var o = { order_id: newOrderId(), user_id: ctx.uid, app: ctx.app, plan: plan.id, method: method, status: 'pending', created_at: new Date(), edition: ctx.urow.edition || '', code: pr.code || '', discount: pr.pct || '' };
  if (method === 'stars') {
    o.amount = plan.stars; o.currency = 'XTR';
    var r = tgCall(ctx.token, 'createInvoiceLink', { title: (ctx.st.appName + ' — ' + plan.label).slice(0, 32), description: plan.label + ' (' + plan.days + ' days)',
      payload: o.order_id, currency: 'XTR', prices: [{ label: plan.label.slice(0, 32), amount: plan.stars }] });
    if (!r.ok) return { ok: false, error: 'invoice_failed' };
    append('Payments', o);
    return { ok: true, order_id: o.order_id, method: method, invoiceLink: r.result };
  }
  if (USDT[method]) {
    var lock = LockService.getScriptLock(); lock.waitLock(10000); _rc = {};
    try {
      var used = {}; rows('Payments').forEach(function (p) { if (p.method === method && p.status === 'pending') used[String(p.amount)] = 1; });
      var amt; for (var i = 0; i < 50; i++) { amt = (plan.usd + (Math.floor(Math.random() * 9000) + 1000) / 1e6).toFixed(4); if (!used[amt]) break; }
      o.amount = amt; o.currency = 'USDT'; o.note = ctx.st.methods[method];
      append('Payments', o);
    } finally { lock.releaseLock(); }
    return { ok: true, order_id: o.order_id, method: method, amount: o.amount, address: ctx.st.methods[method], network: USDT[method].network };
  }
  // local mobile money: manual confirmation, phone must be verified with an allowed prefix
  if (!(ctx.urow.phone_verified === true || ctx.urow.phone_verified === 'TRUE')) return { ok: false, error: 'phone_required' };
  o.amount = '$' + plan.usd.toFixed(2); o.currency = 'USD';
  append('Payments', o);
  return { ok: true, order_id: o.order_id, method: method, amount: o.amount, number: ctx.st.methods[method] };
}
function ownOrder(ctx, id) { return find('Payments', function (p) { return p.order_id === id && String(p.user_id) === ctx.uid && p.app === ctx.app; }); }
function checkOrder(ctx, req) {
  var o = ownOrder(ctx, req.order_id); if (!o) return { ok: false, error: 'order' };
  if (o.status === 'pending' && USDT[o.method]) { if (checkUsdtOrder(o)) o.status = 'paid'; }
  return { ok: true, status: o.status, access: accessFor(ctx) };
}
function submitManual(ctx, req) {
  var o = ownOrder(ctx, req.order_id); if (!o) return { ok: false, error: 'order' };
  if (o.status !== 'pending' || LOCAL_METHODS.indexOf(o.method) < 0) return { ok: false, error: 'state' };
  var tx = String(req.txid || '').trim().slice(0, 80);
  if (tx.length < 4) return { ok: false, error: 'txid' };
  if (find('Payments', function (p) { return p.tx_ref === tx && p.method === o.method; })) return { ok: false, error: 'duplicate_tx' };
  update('Payments', o, { status: 'review', tx_ref: tx });
  notifyAdmins(ctx.app, 'Payment to review: ' + o.method + ' ' + o.amount + ' — user ' + ctx.uid + ' — tx ' + tx + ' — order ' + o.order_id);
  return { ok: true, status: 'review' };
}
function markPaid(o, txRef) { var done = markPaidInner(o, txRef); if (done) try { afterPaid(o.order_id); } catch (e) { log('', o.app, 'afterpaid_error', e); } return done; }
function markPaidInner(o, txRef) {
  var lock = LockService.getScriptLock(); lock.waitLock(10000); _rc = {};
  try {
    var fresh = find('Payments', function (p) { return p.order_id === o.order_id; });
    if (!fresh || fresh.status === 'paid') return false;
    var H = APP_HOOKS[fresh.app], st = getSettings(fresh.app);
    var plan = (H && H.planForOrder ? H.planForOrder(fresh) : (st.plans || []).filter(function (p) { return p.id === fresh.plan; })[0]) || { days: 30 };
    if (H && H.onPaid) {
      var exp2 = H.onPaid(fresh, plan);
      update('Payments', fresh, { status: 'paid', paid_at: new Date(), expiry_date: exp2 || '', tx_ref: txRef || fresh.tx_ref });
      log(fresh.user_id, fresh.app, 'paid', fresh.method + ' ' + fresh.amount);
      return true;
    }
    if (Number(plan.credits) > 0 && !(Number(plan.days) > 0)) {
      var us = usageRow(fresh.user_id, fresh.app), total = (Number(us.credits) || 0) + Number(plan.credits);
      update('Usage', us, { credits: total });
      update('Payments', fresh, { status: 'paid', paid_at: new Date(), tx_ref: txRef || fresh.tx_ref });
      log(fresh.user_id, fresh.app, 'paid', fresh.method + ' ' + fresh.amount);
      notify(fresh.app, fresh.user_id, 'Payment confirmed. ' + plan.credits + ' credit(s) added. Balance: ' + total + '.');
      return true;
    }
    var cur = activeSub(fresh.user_id, fresh.app), start = cur ? new Date(cur.expiry_date) : new Date(), exp = new Date(start.getTime() + (Number(plan.days) || 30) * 864e5);
    update('Payments', fresh, { status: 'paid', paid_at: new Date(), expiry_date: exp, tx_ref: txRef || fresh.tx_ref });
    append('Subscriptions', { user_id: String(fresh.user_id), app: fresh.app, plan: fresh.plan, status: 'active', start_date: new Date(), expiry_date: exp, edition: fresh.edition, order_id: fresh.order_id });
    log(fresh.user_id, fresh.app, 'paid', fresh.method + ' ' + fresh.amount);
    notify(fresh.app, fresh.user_id, 'Payment confirmed. Your plan is active until ' + exp.toISOString().slice(0, 10) + '.');
    return true;
  } finally { lock.releaseLock(); }
}

/* ======================= DISCOUNT CODES & REFERRALS ======================= */
// Codes sheet: scope 'all' = platform code made by the admin (not valid on creators' channel plans);
// scope 'ch:<key>' = a channel creator's code for their own buyers (Channel Pass).
function refOn(st) { return st.x_refOn === true || st.x_refOn === 'TRUE'; }
function codeOut(c) { return { code: c.code, scope: c.scope, pct: Number(c.pct) || 0, max_uses: Number(c.max_uses) || 0, used: Number(c.used) || 0,
  expires: c.expires instanceof Date ? Utilities.formatDate(c.expires, 'UTC', 'yyyy-MM-dd') : String(c.expires || ''), plans: String(c.plans || ''), active: c.active === true || c.active === 'TRUE', note: c.note || '' }; }
function findCode(app, code, planId) {
  code = String(code || '').trim().toUpperCase(); if (!code) return { none: true };
  var row = find('Codes', function (c) { return c.app === app && String(c.code).toUpperCase() === code; });
  if (!row) return { error: 'code_invalid' };
  var c = codeOut(row), chKey = String(planId || '').indexOf('|') > 0 ? String(planId).split('|')[0] : '';
  if (!c.active) return { error: 'code_invalid' };
  if (c.expires && c.expires < Utilities.formatDate(new Date(), 'UTC', 'yyyy-MM-dd')) return { error: 'code_expired' };
  if (c.max_uses && c.used >= c.max_uses) return { error: 'code_used_up' };
  if (c.scope === 'all' ? !!chKey : c.scope !== 'ch:' + chKey) return { error: 'code_not_for_plan' };
  if (c.plans && planId && c.plans.split(',').map(function (x) { return x.trim(); }).indexOf(chKey ? String(planId).split('|')[1] : planId) < 0) return { error: 'code_not_for_plan' };
  return { row: row, code: c.code, pct: Math.max(0, Math.min(100, c.pct)) };
}
function refFirstPct(ctx) {   // new users who came through a referral link get a discount on their first purchase
  if (!refOn(ctx.st) || !ctx.urow || !ctx.urow.referred_by) return 0;
  var paid = find('Payments', function (p) { return String(p.user_id) === ctx.uid && p.app === ctx.app && p.status === 'paid'; });
  return paid ? 0 : Math.max(0, Math.min(90, Number(ctx.st.x_refNewPct) || 0));
}
function priceFor(ctx, plan, code) {
  var f = findCode(ctx.app, code, plan.id); if (f.error) return { error: f.error };
  var refPct = String(plan.id).indexOf('|') > 0 ? 0 : refFirstPct(ctx), pct = Math.max(f.pct || 0, refPct);
  var usd = Math.round(Number(plan.usd || 0) * (100 - pct)) / 100, stars = Math.ceil(Number(plan.stars || 0) * (100 - pct) / 100);
  return { usd: usd, stars: stars, pct: pct, code: f.pct >= refPct ? (f.code || '') : '', free: pct >= 100 };
}
function checkCode(ctx, req) {
  var f = findCode(ctx.app, req.code, req.plan); if (f.error) return { ok: false, error: f.error }; if (f.none) return { ok: false, error: 'code_invalid' };
  return { ok: true, code: f.code, pct: f.pct };
}
function codeSave(ctx, req, scope) {
  var code = String(req.code || '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '');
  if (code.length < 3 || code.length > 20) return { ok: false, error: 'code_format' };
  var pct = Math.round(Number(req.pct)); if (!(pct >= 1 && pct <= 100)) return { ok: false, error: 'code_pct' };
  var row = find('Codes', function (c) { return c.app === ctx.app && String(c.code).toUpperCase() === code; });
  var data = { pct: pct, max_uses: Math.max(0, Math.round(Number(req.max_uses) || 0)), expires: String(req.expires || '').slice(0, 10), plans: String(req.plans || '').replace(/[^\w,-]/g, '').slice(0, 200),
    note: String(req.note || '').slice(0, 80), active: req.active !== false };
  if (row) { if (row.scope !== scope) return { ok: false, error: 'code_taken' }; update('Codes', row, data); }
  else append('Codes', Object.assign({ code: code, app: ctx.app, scope: scope, owner_id: ctx.uid, used: 0, created_at: new Date() }, data));
  return { ok: true };
}
function codeToggle(ctx, req, scope) {
  var row = find('Codes', function (c) { return c.app === ctx.app && c.scope === scope && String(c.code).toUpperCase() === String(req.code || '').toUpperCase(); });
  if (!row) return { ok: false, error: 'code_invalid' };
  update('Codes', row, { active: !!req.active }); return { ok: true };
}
function refStats(ctx) {
  var r = rows('Referrals').filter(function (x) { return x.app === ctx.app && String(x.referrer_id) === ctx.uid; });
  return { ok: true, on: refOn(ctx.st), arg: 'r' + ctx.uid, invited: r.length, rewarded: r.filter(function (x) { return x.status === 'rewarded'; }).length,
    days: Number(ctx.st.x_refDays) || 0, credits: Number(ctx.st.x_refCredits) || 0, newPct: Number(ctx.st.x_refNewPct) || 0 };
}
// After a payment: count the code use; reward the inviter on the referee's first paid purchase.
function afterPaid(orderId) {
  var p = find('Payments', function (x) { return x.order_id === orderId; }); if (!p) return;
  if (p.code) { var c = find('Codes', function (x) { return x.app === p.app && String(x.code).toUpperCase() === String(p.code).toUpperCase(); }); if (c) update('Codes', c, { used: (Number(c.used) || 0) + 1 }); }
  var st = getSettings(p.app); if (!refOn(st)) return;
  var ref = find('Referrals', function (x) { return x.app === p.app && String(x.referee_id) === String(p.user_id) && x.status === 'joined'; }); if (!ref) return;
  var days = Number(st.x_refDays) || 0, credits = Number(st.x_refCredits) || 0, rid = String(ref.referrer_id), parts = [];
  if (days > 0) { var cur = activeSub(rid, p.app), start = cur ? new Date(cur.expiry_date) : new Date(), exp = new Date(start.getTime() + days * 864e5);
    append('Subscriptions', { user_id: rid, app: p.app, plan: 'referral', status: 'active', start_date: new Date(), expiry_date: exp, edition: '', order_id: 'REF-' + p.order_id }); parts.push(days + ' free days'); }
  if (credits > 0) { var us = usageRow(rid, p.app); update('Usage', us, { credits: (Number(us.credits) || 0) + credits }); parts.push(credits + ' free credit(s)'); }
  update('Referrals', ref, { status: 'rewarded', rewarded_at: new Date(), reward: parts.join(' + ') });
  if (parts.length) notify(p.app, rid, 'A friend you invited just joined. You received ' + parts.join(' + ') + '. Thank you!');
}

/* ---- USDT on-chain checks ---- */
function checkUsdtOrder(o) {
  var created = new Date(o.created_at).getTime(), cfg = USDT[o.method], addr = String(o.note || '');
  if (!addr) return false;
  var want = toUnits(String(o.amount), cfg.decimals), txs = [];
  try {
    if (o.method === 'usdt_trc20') {
      var h = prop('TRONGRID_KEY') ? { 'TRON-PRO-API-KEY': prop('TRONGRID_KEY') } : {};
      var r = JSON.parse(UrlFetchApp.fetch('https://api.trongrid.io/v1/accounts/' + addr + '/transactions/trc20?only_to=true&limit=50&contract_address=' + cfg.contract + '&min_timestamp=' + (created - 3e5), { headers: h, muteHttpExceptions: true }).getContentText());
      txs = (r.data || []).map(function (x) { return { id: x.transaction_id, to: x.to, value: String(x.value), ts: x.block_timestamp }; });
    } else {
      var key = prop('ETHERSCAN_KEY'); if (!key) return false;
      var r2 = JSON.parse(UrlFetchApp.fetch('https://api.etherscan.io/v2/api?chainid=56&module=account&action=tokentx&contractaddress=' + cfg.contract + '&address=' + addr + '&page=1&offset=50&sort=desc&apikey=' + key, { muteHttpExceptions: true }).getContentText());
      txs = (Array.isArray(r2.result) ? r2.result : []).map(function (x) { return { id: x.hash, to: x.to, value: String(x.value), ts: Number(x.timeStamp) * 1000 }; });
    }
  } catch (e) { return false; }
  var usedTx = {}; rows('Payments').forEach(function (p) { if (p.tx_ref) usedTx[p.tx_ref] = 1; });
  for (var i = 0; i < txs.length; i++) {
    var t = txs[i];
    if (String(t.to).toLowerCase() === addr.toLowerCase() && stripZeros(t.value) === stripZeros(want) && t.ts >= created - 3e5 && !usedTx[t.id]) return markPaid(o, t.id);
  }
  return false;
}
function toUnits(s, dec) { var p = s.split('.'), f = (p[1] || '') + new Array(dec + 1).join('0'); return p[0] + f.slice(0, dec); }
function stripZeros(s) { return String(s).replace(/^0+/, '') || '0'; }

/* ======================= ADMIN ======================= */
function adminSetSecret(ctx, req) {
  var allowed = { BOT_TOKEN: 'BOT_TOKEN_' + ctx.app, TRONGRID_KEY: 'TRONGRID_KEY', ETHERSCAN_KEY: 'ETHERSCAN_KEY' };
  (APP_SECRETS[ctx.app] || []).forEach(function (s) { allowed[s] = s; });
  var k = allowed[req.key];
  if (!k) return { ok: false, error: 'key' };
  var v = String(req.value || '').trim(); if (!v) return { ok: false, error: 'empty' };
  setProp(k, v); log(ctx.uid, ctx.app, 'secret_set', req.key);
  return { ok: true };
}
function adminDecide(ctx, req) {
  var o = find('Payments', function (p) { return p.order_id === req.order_id && p.app === ctx.app; });
  if (!o || o.status !== 'review') return { ok: false, error: 'state' };
  if (req.approve) markPaid(o, o.tx_ref);
  else { update('Payments', o, { status: 'rejected' }); notify(ctx.app, o.user_id, 'Your payment could not be confirmed. Please contact support.'); }
  log(ctx.uid, ctx.app, req.approve ? 'approved' : 'rejected', o.order_id);
  return { ok: true };
}
function adminStats(ctx) {
  var a = ctx.app, now = new Date();
  return { ok: true, stats: {
    users: rows('Users').filter(function (r) { return r.app === a; }).length,
    activeSubs: rows('Subscriptions').filter(function (r) { return r.app === a && r.status === 'active' && new Date(r.expiry_date) > now; }).length,
    conversions: rows('Usage').filter(function (r) { return r.app === a; }).reduce(function (s, r) { return s + (Number(r.total_used) || 0); }, 0),
    paidOrders: rows('Payments').filter(function (r) { return r.app === a && r.status === 'paid'; }).length,
    pending: rows('Payments').filter(function (r) { return r.app === a && r.status === 'review'; }).length } };
}
/* Revenue report: last 12 months. scope 'all' covers every app that writes to the same master sheet (shared MASTER_SHEET_ID).
   USD = USDT + mobile money (dollar amounts). Stars are reported separately (their USD value depends on Telegram's payout rate). */
function adminRevenue(ctx, req) {
  var all = req.scope === 'all', now = new Date(), months = [], idx = {};
  for (var i = 11; i >= 0; i--) { var d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - i, 1)), k = d.toISOString().slice(0, 7); idx[k] = months.length; months.push({ month: k, orders: 0, usd: 0, stars: 0, newUsers: 0 }); }
  var byMethod = {}, byPlan = {}, byApp = {}, T = { orders: 0, usd: 0, stars: 0, users: 0, activeSubs: 0, pendingReview: 0 };
  function app(a) { return byApp[a] || (byApp[a] = { app: a, orders: 0, usd: 0, stars: 0, users: 0, activeSubs: 0 }); }
  function amt(p) { return p.currency === 'XTR' ? { usd: 0, stars: Number(p.amount) || 0 } : { usd: Number(String(p.amount).replace(/[^\d.]/g, '')) || 0, stars: 0 }; }
  rows('Payments').forEach(function (p) {
    if (!all && p.app !== ctx.app) return;
    if (p.status === 'review') T.pendingReview++;
    if (p.status !== 'paid') return;
    var a = amt(p), k = new Date(p.paid_at || p.created_at).toISOString().slice(0, 7), A = app(p.app);
    T.orders++; T.usd += a.usd; T.stars += a.stars; A.orders++; A.usd += a.usd; A.stars += a.stars;
    if (idx[k] !== undefined) { var m = months[idx[k]]; m.orders++; m.usd += a.usd; m.stars += a.stars; }
    var bm = byMethod[p.method] || (byMethod[p.method] = { method: p.method, orders: 0, usd: 0, stars: 0 }); bm.orders++; bm.usd += a.usd; bm.stars += a.stars;
    var pk = (all ? p.app + ' · ' : '') + String(p.plan).replace(/^task:.*/, 'task funding').replace(/^\w+\|.*/, 'channel access');
    var bp = byPlan[pk] || (byPlan[pk] = { plan: pk, orders: 0, usd: 0, stars: 0 }); bp.orders++; bp.usd += a.usd; bp.stars += a.stars;
  });
  rows('Users').forEach(function (u) {
    if (!all && u.app !== ctx.app) return;
    T.users++; app(u.app).users++;
    var k = new Date(u.created_at).toISOString().slice(0, 7); if (idx[k] !== undefined) months[idx[k]].newUsers++;
  });
  rows('Subscriptions').forEach(function (s) { if ((all || s.app === ctx.app) && s.status === 'active' && new Date(s.expiry_date) > now) { T.activeSubs++; app(s.app).activeSubs++; } });
  function r2(o) { ['usd'].forEach(function (k) { if (k in o) o[k] = Math.round(o[k] * 100) / 100; }); return o; }
  function vals(o) { return Object.keys(o).map(function (k) { return r2(o[k]); }).sort(function (a, b) { return (b.usd + b.stars / 100) - (a.usd + a.stars / 100); }); }
  return { ok: true, scope: all ? 'all' : ctx.app, appName: ctx.st.appName, months: months.map(r2), byMethod: vals(byMethod), byPlan: vals(byPlan), byApp: vals(byApp), totals: r2(T) };
}
function adminResetMe(ctx) {
  var us = usageRow(ctx.uid, ctx.app); update('Usage', us, { free_used: 0, credits: 0 });
  rows('Subscriptions').forEach(function (s) { if (String(s.user_id) === ctx.uid && s.app === ctx.app && s.status === 'active') update('Subscriptions', s, { status: 'cancelled' }); });
  update('Users', ctx.urow, { phone_verified: false, phone: '' });
  return { ok: true };
}

/* ======================= AI (Gemini) — used by the coach and translator apps ======================= */
// parts: [{text:'...'}, {inline_data:{mime_type:'audio/wav', data: base64}}]. Returns parsed JSON or throws.
// Model name comes from settings.x_aiModel; key from Script property GEMINI_KEY. Check pricing at ai.google.dev.
function aiJson(parts, model) {
  var key = prop('GEMINI_KEY'); if (!key) throw new Error('ai_not_configured');
  var url = 'https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(model || 'gemini-2.5-flash') + ':generateContent';
  var r = UrlFetchApp.fetch(url, { method: 'post', contentType: 'application/json', muteHttpExceptions: true, headers: { 'x-goog-api-key': key },
    payload: JSON.stringify({ contents: [{ role: 'user', parts: parts }], generationConfig: { temperature: 0.3, responseMimeType: 'application/json' } }) });
  if (r.getResponseCode() !== 200) throw new Error('ai_http_' + r.getResponseCode());
  var j = JSON.parse(r.getContentText()), txt = (((j.candidates || [])[0] || {}).content || {}).parts;
  txt = (txt || []).map(function (x) { return x.text || ''; }).join('');
  return JSON.parse(txt.replace(/^```(json)?|```$/g, '').trim());
}

/* ======================= SERVER-TO-SERVER (Netlify webhook) ======================= */
function serverRoute(req) {
  if (!prop('SERVER_SECRET') || req.serverSecret !== prop('SERVER_SECRET')) return { ok: false, error: 'forbidden' };
  var app = appId(req.app);
  switch (req.action) {
    case 'precheckout':
      var o = find('Payments', function (p) { return p.order_id === req.order_id && p.app === app; });
      var valid = !!o && o.status === 'pending' && String(o.user_id) === String(req.user_id) && Number(o.amount) === Number(req.total) && req.currency === 'XTR';
      return { ok: true, valid: valid, error: valid ? '' : 'Order is not valid any more.' };
    case 'starsPaid':
      var p = find('Payments', function (x) { return x.order_id === req.order_id && x.app === app; });
      if (!p || String(p.user_id) !== String(req.user_id)) return { ok: false, error: 'order' };
      markPaid(p, req.charge_id); return { ok: true };
    case 'contact':
      var phone = String(req.phone || '').replace(/[^\d]/g, ''), st = getSettings(app);
      var local = st.localPrefixes.split(',').filter(String).some(function (pre) { return phone.indexOf(pre) === 0; });
      var u = find('Users', function (x) { return String(x.user_id) === String(req.user_id) && x.app === app; });
      if (u) update('Users', u, { phone: '+' + phone, phone_verified: local, region: local ? 'LOCAL' : u.region });
      return { ok: true, local: local };
  }
  var H = APP_HOOKS[app];
  if (req.action === 'botStart') return H && H.botStart ? H.botStart(req) : { ok: true };
  if (H && H.server && H.server[req.action]) return H.server[req.action](req);
  return { ok: false, error: 'unknown_action' };
}

/* ======================= TRIGGERS ======================= */
function cronUsdt() {
  try { processOutbox(400); } catch (e) { log('', 'cron', 'outbox_error', e); }
  var now = Date.now();
  rows('Payments').forEach(function (p) {
    if (p.status !== 'pending' || !USDT[p.method]) return;
    if (now - new Date(p.created_at).getTime() > ORDER_TTL_HOURS * 36e5) { update('Payments', p, { status: 'expired' }); return; }
    checkUsdtOrder(p);
  });
}
var DAILY_JOBS = DAILY_JOBS || [];
function cronDaily() {
  DAILY_JOBS.forEach(function (fn) { try { fn(); } catch (e) { log('', 'cron', 'error', e); } });
  var now = new Date(), soon = new Date(now.getTime() + 3 * 864e5);
  rows('Subscriptions').forEach(function (s) {
    if (s.status !== 'active') return;
    var exp = new Date(s.expiry_date);
    if (exp <= now) { update('Subscriptions', s, { status: 'expired' }); notify(s.app, s.user_id, 'Your plan has expired. Open the app to renew.'); }
    else if (exp <= soon && exp > new Date(soon.getTime() - 864e5)) notify(s.app, s.user_id, 'Your plan expires on ' + exp.toISOString().slice(0, 10) + '.');
  });
}

/* App modules add their own hourly jobs to HOURLY_JOBS. */
var HOURLY_JOBS = HOURLY_JOBS || [];
function cronHourly() { HOURLY_JOBS.forEach(function (fn) { try { fn(); } catch (e) { log('', 'cron', 'error', e); } }); }

/* ======================= INSTALL (run once from the editor) ======================= */
function install() {
  var id = prop('MASTER_SHEET_ID'), book;
  if (id) book = SpreadsheetApp.openById(id);
  else { book = SpreadsheetApp.create('ledger-' + Utilities.getUuid().slice(0, 6)); setProp('MASTER_SHEET_ID', book.getId()); }
  _ss = book;
  Object.keys(EXTRA_SCHEMA).forEach(function (n) { SCHEMA[n] = EXTRA_SCHEMA[n]; });
  Object.keys(SCHEMA).forEach(function (n) {
    var s = book.getSheetByName(n) || book.insertSheet(n);
    s.getRange(1, 1, 1, SCHEMA[n].length).setValues([SCHEMA[n]]).setFontWeight('bold'); s.setFrozenRows(1);
  });
  var def = book.getSheetByName('Sheet1'); if (def && book.getSheets().length > 1) book.deleteSheet(def);
  if (!prop('SERVER_SECRET')) setProp('SERVER_SECRET', Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, ''));
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('cronUsdt').timeBased().everyMinutes(5).create();
  ScriptApp.newTrigger('cronDaily').timeBased().everyDays(1).atHour(6).create();
  ScriptApp.newTrigger('cronHourly').timeBased().everyHours(1).create();
  Logger.log('Master sheet: ' + book.getUrl());
  Logger.log('Copy SERVER_SECRET from Project Settings -> Script properties into Netlify env var SERVER_SECRET.');
}

/**
 * Connect the bot to its Mini App: set Script property BOT_TOKEN_<app> and THIS_APP.url, then run
 * connectTelegram(). Registers the webhook (Netlify function), the menu button and the commands.
 */
function connectTelegram() {
  var app = THIS_APP.id, token = botToken(app);
  if (!THIS_APP.url) throw new Error('Set THIS_APP.url (the Netlify site URL) in the app file first');
  if (!token) throw new Error('Set Script property BOT_TOKEN_' + app + ' first');
  var whSecret = prop('WEBHOOK_SECRET_' + app);
  if (!whSecret) { whSecret = Utilities.getUuid().replace(/-/g, ''); setProp('WEBHOOK_SECRET_' + app, whSecret); }
  Logger.log(tgCall(token, 'setWebhook', { url: THIS_APP.url + '/api/telegram', secret_token: whSecret, drop_pending_updates: true,
    allowed_updates: ['message', 'pre_checkout_query', 'my_chat_member', 'chat_join_request'] }));
  Logger.log(tgCall(token, 'setChatMenuButton', { menu_button: { type: 'web_app', text: THIS_APP.button, web_app: { url: THIS_APP.url } } }));
  Logger.log(tgCall(token, 'setMyCommands', { commands: [
    { command: 'start', description: 'Open the app' }, { command: 'paysupport', description: 'Payment support' }, { command: 'terms', description: 'Terms of service' } ] }));
  Logger.log('Done. Copy WEBHOOK_SECRET_' + app + ' and SERVER_SECRET (Script properties) into the Netlify env vars WEBHOOK_SECRET and SERVER_SECRET.');
}
